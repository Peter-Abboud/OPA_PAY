@model OPA_Pay.Models.Currency
@{ ViewData["Title"] = "Edit Currency"; }

<div class="page-header"><h1>Edit @Model.Code</h1></div>
<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="opa-card">
            <div class="opa-card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input asp-for="Code" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Exchange Rate</label>
                        <input asp-for="ExchangeRate" class="form-control" type="number" step="0.0001" required />
                    </div>
                    <button class="btn btn-opa w-100">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
