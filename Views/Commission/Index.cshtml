@model IEnumerable<OPA_Pay.Models.Commission>
@{ ViewData["Title"] = "Commissions"; }

<div class="page-header">
    <h1>Commission Structure</h1>
    <p>Percentage applies to the transfer amount. Fixed amount is in USD and converted to the sender's wallet currency.</p>
</div>

@foreach (var c in Model)
{
    <div class="opa-card mb-3 col-lg-6">
        <div class="opa-card-body">
            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@c.Id" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Percentage (%)</label>
                        <input type="number" name="percentage" value="@c.Percentage" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fixed Fee (USD)</label>
                        <input type="number" name="fixedAmount" value="@c.FixedAmount" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-opa w-100">
                            @(c.IsActive ? "Update Active" : "Set Active")
                        </button>
                    </div>
                </div>
                @if (c.IsActive) { <span class="badge bg-success mt-2">Currently Active</span> }
            </form>
        </div>
    </div>
}
