@model OPA_Pay.ViewModels.CurrencyExchangeViewModel
@{ ViewData["Title"] = "Exchange Currency"; }

<div class="page-header">
    <h1>Exchange Currency</h1>
    <p>Move funds between your USD, EUR, and LBP wallets using live exchange rates</p>
</div>

@if (ViewBag.HasAccounts != true)
{
    <div class="alert alert-warning alert-opa">
        You need at least <strong>two accounts</strong> in different currencies.
        <a asp-action="Create" class="alert-link">Create another wallet</a> (e.g. EUR or LBP).
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="opa-card">
            <div class="opa-card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">From Account</label>
                        <select asp-for="FromAccountId" class="form-select" asp-items="ViewBag.FromAccounts" required>
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">To Account</label>
                        <select asp-for="ToAccountId" class="form-select" asp-items="ViewBag.ToAccounts" required>
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Amount (source currency)</label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" required />
                    </div>
                    <button type="submit" class="btn btn-opa w-100" @(ViewBag.HasAccounts != true ? "disabled" : "")>
                        <i class="fa fa-right-left me-2"></i> Exchange
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
