@model OPA_Pay.ViewModels.AccountCreateViewModel
@{ ViewData["Title"] = "Create Account"; }

<div class="page-header">
    <h1>Create Wallet</h1>
    <p>Open a new account in USD, EUR, or LBP (one wallet per currency)</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="opa-card">
            <div class="opa-card-body">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Initial Balance</label>
                        <input asp-for="Balance" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Balance" class="text-danger"></span>
                        <div class="form-text">Example: 1000000 for LBP wallet</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Currency</label>
                        <select asp-for="CurrencyId" class="form-select" asp-items="ViewBag.Currencies" required></select>
                        <span asp-validation-for="CurrencyId" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-opa w-100">Create Wallet</button>
                    <a asp-action="Index" class="btn btn-opa-outline w-100 mt-2">Back</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
