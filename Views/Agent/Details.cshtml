@model OPA_Pay.Models.Agent

<h2 class="mb-4 text-info">
    Agent Details
</h2>

<div class="card shadow p-4">

    <h4>@Model.OfficeName</h4>

    <hr />

    <p>
        <strong>City:</strong>
        @Model.City
    </p>

    <p>
        <strong>Latitude:</strong>
        @Model.Latitude
    </p>

    <p>
        <strong>Longitude:</strong>
        @Model.Longitude
    </p>

</div>
