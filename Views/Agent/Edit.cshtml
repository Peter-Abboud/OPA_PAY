@model OPA_Pay.Models.Agent

<h2 class="mb-4 text-warning">
    Edit Agent
</h2>

<form method="post"
      class="shadow p-4 rounded bg-light">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label>Office Name</label>

        <input asp-for="OfficeName"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>City</label>

        <input asp-for="City"
               class="form-control" />

    </div>

    <button class="btn btn-warning w-100">
        Save Changes
    </button>

</form>
