@model OPA_Pay.Models.Agent
@{ ViewData["Title"] = "Agent Dashboard"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Agent Dashboard</h1>
        <p>@(Model?.OfficeName ?? "Complete your profile")</p>
    </div>
    @if (ViewBag.IsApproved == true)
    {
        <form asp-action="ToggleOpen" method="post">
            @Html.AntiForgeryToken()
            <button class="btn @(Model?.IsOpen == true ? "btn-warning" : "btn-success")">
                @(Model?.IsOpen == true ? "Mark Closed" : "Mark Open")
            </button>
        </form>
    }
</div>

@if (ViewBag.IsApproved != true)
{
    <div class="alert alert-warning alert-opa">
        <i class="fa fa-clock me-2"></i> Your agent profile is pending admin approval.
        <a asp-action="Profile" class="alert-link">Complete your profile</a>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Pending Pickups</div>
            <div class="stat-value text-warning">@ViewBag.PendingPickups</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Est. Commissions</div>
            <div class="stat-value text-success">@(((decimal)ViewBag.TotalCommissions).ToString("N2"))</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Status</div>
            <div class="stat-value fs-5">
                @(Model?.IsOpen == true ? "Open" : "Closed")
            </div>
        </div>
    </div>
</div>

<div class="opa-card">
    <div class="opa-card-header">Recent Mobile Pickups</div>
    <div class="table-responsive">
        <table class="table table-opa mb-0">
            <thead>
                <tr><th>Reference</th><th>Recipient</th><th>Amount</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var t in (IEnumerable<OPA_Pay.Models.Transfer>)ViewBag.RecentPickups)
                {
                    <tr>
                        <td><code class="small">@t.Reference</code></td>
                        <td>@t.Beneficiary?.FullName</td>
                        <td>@t.Amount.ToString("N2")</td>
                        <td><span class="badge-status badge-pending">@t.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="CashIn" class="btn btn-opa"><i class="fa fa-hand-holding-dollar me-1"></i> Cash Pickups</a>
    <a asp-action="Profile" class="btn btn-opa-outline">Edit Profile</a>
</div>
