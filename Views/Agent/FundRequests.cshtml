@model IEnumerable<OPA_Pay.Models.FundRequest>
@{ ViewData["Title"] = "Fund Requests"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1>Client Fund Requests</h1>
        <p class="mb-0">Approve deposit requests and credit client wallets at your office.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i> Agent Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-opa">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-opa">@TempData["Error"]</div>
}

@if (ViewBag.IsApproved != true)
{
    <div class="alert alert-warning alert-opa">
        <i class="fa fa-clock me-2"></i>
        Your agent profile is pending admin approval. You can view requests but cannot approve them yet.
    </div>
}

@if (!Model.Any())
{
    <div class="opa-card">
        <div class="opa-card-body text-center text-muted py-5">No pending fund requests.</div>
    </div>
}
else
{
    <div class="table-responsive opa-card">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Client</th>
                    <th>Wallet</th>
                    <th>Amount</th>
                    <th>Requested</th>
                    @if (ViewBag.IsApproved == true)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model)
                {
                    <tr>
                        <td>
                            <strong>@req.User?.FullName</strong><br />
                            <small class="text-muted">@req.User?.Email</small>
                        </td>
                        <td>
                            @req.Account?.AccountNumber<br />
                            <span class="badge bg-secondary">@req.Account?.Currency?.Code</span>
                        </td>
                        <td class="fw-semibold">@req.Amount.ToString("N2")</td>
                        <td>@req.CreatedAt.ToString("g")</td>
                        @if (ViewBag.IsApproved == true)
                        {
                            <td class="text-end text-nowrap">
                                <form method="post" asp-action="ApproveFundRequest" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="btn btn-opa btn-sm">
                                        <i class="fa fa-check me-1"></i> Approve
                                    </button>
                                </form>
                                <form method="post" asp-action="RejectFundRequest" class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@req.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Reject this fund request?');">
                                        <i class="fa fa-times me-1"></i> Reject
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
