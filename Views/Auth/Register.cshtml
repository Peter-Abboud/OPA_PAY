@model OPA_Pay.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-card-header">
            <i class="fa fa-user-plus fa-2x mb-3"></i>
            <h2 class="mb-0">Create Account</h2>
            <p class="mb-0 opacity-75 small">Join OPA Pay for fast, secure transfers</p>
        </div>
        <div class="auth-card-body">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select asp-for="RoleType" class="form-select" id="roleSelect">
                        <option value="">-- Select Role --</option>
                        <option value="Client">Client (Send & Receive Money)</option>
                        <option value="Agent">Agent (Partner Store)</option>
                    </select>
                </div>
                <div class="mb-4" id="currencySection">
                    <label asp-for="PreferredCurrencyId" class="form-label fw-semibold"></label>
                    <select asp-for="PreferredCurrencyId" class="form-select">
                        <option value="1">USD — US Dollar</option>
                        <option value="2">EUR — Euro</option>
                        <option value="3">LBP — Lebanese Pound</option>
                    </select>
                    <span asp-validation-for="PreferredCurrencyId" class="text-danger"></span>
                    <p class="small text-muted mt-2 mb-0">
                        You receive all three wallets (USD, EUR, LBP) at 0 balance. This sets your default active wallet.
                    </p>
                </div>
                <button type="submit" class="btn btn-opa w-100 py-2">Create Account</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const roleSelect = document.getElementById('roleSelect');
        const currencySection = document.getElementById('currencySection');
        function updateCurrencySection() {
            currencySection.style.display = roleSelect.value === 'Client' ? 'block' : 'none';
        }
        roleSelect.addEventListener('change', updateCurrencySection);
        updateCurrencySection();
    </script>
}
