@model IEnumerable<OPA_Pay.Models.Review>

@{ ViewData["Title"] = "Agent Reviews"; var agent = ViewBag.Agent as OPA_Pay.Models.Agent; }



<div class="page-header">

    <h1>Reviews for @agent?.OfficeName</h1>

    <p>@agent?.City</p>

    @if (ViewBag.ReviewCount > 0)

    {

        <div class="d-flex align-items-center gap-2 mt-2">

            <span class="text-warning fs-4">

                @for (int i = 1; i <= 5; i++)

                {

                    <i class="fa @(i <= Math.Round((double)ViewBag.AverageRating) ? "fa-star" : "fa-star-o")"></i>

                }

            </span>

            <span class="fw-bold">@(((double)ViewBag.AverageRating).ToString("0.0")) / 5</span>

            <span class="text-muted">(@ViewBag.ReviewCount review@(ViewBag.ReviewCount == 1 ? "" : "s"))</span>

        </div>

    }

</div>



@foreach (var r in Model)

{

    <div class="opa-card mb-2">

        <div class="opa-card-body py-3">

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-warning">

                    @for (int i = 1; i <= 5; i++)

                    {

                        <i class="fa @(i <= r.Rating ? "fa-star" : "fa-star-o")"></i>

                    }

                </span>

                <small class="text-muted">@r.User?.FullName</small>

            </div>

            <p class="mb-0 mt-2">@r.Comment</p>

        </div>

    </div>

}



@if (!Model.Any())

{

    <p class="text-muted">No reviews yet.</p>

}



<a asp-action="Index" class="btn btn-opa-outline mt-3">Back to Agents</a>


