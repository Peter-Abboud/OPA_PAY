@model IEnumerable<OPA_Pay.ViewModels.AgentReviewCardViewModel>
@{ ViewData["Title"] = "Reviews"; }

<div class="page-header">
    <h1>Rate Our Agents</h1>
    <p>Share your experience with OPA Pay partner stores</p>
</div>

@if (ViewBag.EmailEnabled == false)
{
    <div class="alert alert-info alert-opa small">
        <i class="fa fa-envelope me-1"></i>
        Email alerts are off until SMTP is configured in <code>appsettings.json</code> (EmailSettings). In-app notifications still work.
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning alert-opa">
        <i class="fa fa-info-circle me-2"></i>
        No approved agents available for reviews yet.
        @if (ViewBag.PendingCount > 0)
        {
            <span>There are @ViewBag.PendingCount agent(s) waiting for admin approval.</span>
        }
    </div>
    <a asp-controller="Map" asp-action="Index" class="btn btn-opa-outline">View Agent Map</a>
}
else
{
    <div class="row g-4">
        @foreach (var card in Model)
        {
            var agent = card.Agent;
            <div class="col-md-4">
                <div class="feature-card text-start h-100">
                    <h5 class="mb-1">@agent.OfficeName</h5>
                    <p class="text-muted small mb-2"><i class="fa fa-location-dot me-1"></i>@agent.City</p>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        @if (card.ReviewCount > 0)
                        {
                            <span class="text-warning fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa @(i <= Math.Round(card.AverageRating) ? "fa-star" : "fa-star-o")"></i>
                                }
                            </span>
                            <span class="fw-semibold">@card.AverageRating.ToString("0.0")</span>
                            <span class="text-muted small">(@card.ReviewCount review@(card.ReviewCount == 1 ? "" : "s"))</span>
                        }
                        else
                        {
                            <span class="text-muted small">No reviews yet — be the first</span>
                        }
                    </div>

                    <span class="badge-status badge-completed mb-3">Approved</span>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="Create" asp-route-agentId="@agent.Id" class="btn btn-opa btn-sm">
                            <i class="fa fa-star me-1"></i> Leave Review
                        </a>
                        <a asp-action="AgentReviews" asp-route-id="@agent.Id" class="btn btn-opa-outline btn-sm">View Reviews</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
